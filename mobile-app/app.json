{
  "expo": {
    "name": "KharchaAI",
    "slug": "mobile-app",
    "version": "1.0.0",

    "scheme": "kharchaai", 

    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],

    "android": {
      "package": "com.kalpesh.kharchaai",
      "permissions": [
        "RECEIVE_SMS",
        "READ_SMS",
        "BIND_NOTIFICATION_LISTENER_SERVICE",
        "POST_NOTIFICATIONS"
      ]
    }
  }
}